# Defaults for USB Gadget

# USB port mode: "gadget" for USB device mode (network/serial), "host" for USB host mode
# gadget - Enables USB gadget networking (device acts as network adapter to host computer)
# host - Enables USB host mode (device can connect to USB peripherals like flash drives, keyboards)
USB_MODE=gadget

# USB network protocol: "rndis" (default), "ecm" (Linux/macOS), or "both"
# RNDIS works on Windows and Linux with a single host interface.
# "both" also works cross-platform but Linux often binds ECM and RNDIS together
# (two interfaces, same addressing) which can confuse routing.
# Use "ecm" for macOS (no inbox RNDIS host driver).
# Only applies when USB_MODE=gadget
USB_PROTOCOL=rndis

# Toggle USB serial console on ttyGS0 (1=enable, 0=disable)
# When enabled, provides console access via USB ACM (Abstract Control Model)
# Access via /dev/ttyACM0 on host at 1500000 baud
ENABLE_SERIAL_CONSOLE=0

# Toggle USB networking function (1=enable, 0=disable)
# When disabled, only non-network functions (e.g. serial console) are enabled
ENABLE_NETWORK=1

# ADB FunctionFS removed; use SSH over USB networking instead
