From b7f24246b65fc2d4fd38ff51314f522c94c1e98b Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Wed, 2 Sep 2026 02:13:03 +0000
Subject: [PATCH] Move unused snd-pins into the base dtsi.

ConfigFS cannot safely add rockchip pinctrl groups at runtime. Keep
snd-pins in picocalc-luckfox-lyra.dtsi (unused until an overlay claims
them) and drop the /pinctrl fragments from m0-audio and pwm-audio.
---
 luckfox-lyra/overlays/m0-audio-overlay.dts  | 17 ++---------------
 luckfox-lyra/overlays/pwm-audio-overlay.dts | 15 +--------------
 luckfox-lyra/picocalc-luckfox-lyra.dtsi     | 11 +++++++++++
 overlays/overlay-symbols.txt                |  1 +
 4 files changed, 15 insertions(+), 29 deletions(-)

diff --git a/luckfox-lyra/overlays/m0-audio-overlay.dts b/luckfox-lyra/overlays/m0-audio-overlay.dts
index 3e9d4e8..07facb9 100644
--- a/luckfox-lyra/overlays/m0-audio-overlay.dts
+++ b/luckfox-lyra/overlays/m0-audio-overlay.dts
@@ -10,8 +10,8 @@
  * picocalc,snd-m0 sound device. Uses the same pins as PWM audio (RM_IO12/13
  * as GPIO for bit-banged output). Do not load together with pwm-audio overlay.
  *
- * m0_shmem is reserved in picocalc-luckfox-lyra.dtsi at boot. Do not add
- * reserved-memory from this overlay — that is too late and would alias RAM.
+ * m0_shmem and snd_pins are in picocalc-luckfox-lyra.dtsi (base DTB).
+ * This overlay only adds the sound and remoteproc devices.
  *
  * To apply at runtime:
  *   mkdir -p /sys/kernel/config/device-tree/overlays/m0-audio
@@ -51,17 +51,4 @@
             };
         };
     };
-
-    fragment@1 {
-        target-path = "/pinctrl";
-        __overlay__ {
-            picocalc_snd {
-                snd_pins: snd-pins {
-                    rockchip,pins =
-                        <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>,
-                        <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
-                };
-            };
-        };
-    };
 };
diff --git a/luckfox-lyra/overlays/pwm-audio-overlay.dts b/luckfox-lyra/overlays/pwm-audio-overlay.dts
index 1724812..cd57ec4 100644
--- a/luckfox-lyra/overlays/pwm-audio-overlay.dts
+++ b/luckfox-lyra/overlays/pwm-audio-overlay.dts
@@ -41,19 +41,6 @@
     };
 
     fragment@1 {
-        target = <&pinctrl>;
-        __overlay__ {
-            picocalc_snd {
-                snd_pins: snd-pins {
-                    rockchip,pins =
-                        <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>,
-                        <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
-                };
-            };
-        };
-    };
-
-    fragment@2 {
         target = <&pwm0_4ch_0>;
         __overlay__ {
             pinctrl-names = "active";
@@ -64,7 +51,7 @@
         };
     };
 
-    fragment@3 {
+    fragment@2 {
         target = <&pwm0_4ch_1>;
         __overlay__ {
             pinctrl-names = "active";
diff --git a/luckfox-lyra/picocalc-luckfox-lyra.dtsi b/luckfox-lyra/picocalc-luckfox-lyra.dtsi
index dd9f608..1c969ce 100644
--- a/luckfox-lyra/picocalc-luckfox-lyra.dtsi
+++ b/luckfox-lyra/picocalc-luckfox-lyra.dtsi
@@ -18,6 +18,17 @@
                 <0 RK_PB2 34 &pcfg_pull_none>;
         };
     };
+
+    /* Unused until m0-audio or pwm-audio overlay claims them. In the base
+     * DTB so ConfigFS apply does not have to add pinctrl groups at runtime.
+     */
+    picocalc_snd {
+        snd_pins: snd-pins {
+            rockchip,pins =
+                <4 RK_PB2 0 &pcfg_pull_none>,
+                <4 RK_PB3 0 &pcfg_pull_none>;
+        };
+    };
 };
 
 &i2c2{
diff --git a/overlays/overlay-symbols.txt b/overlays/overlay-symbols.txt
index c844d77..84b246f 100644
--- a/overlays/overlay-symbols.txt
+++ b/overlays/overlay-symbols.txt
@@ -11,5 +11,6 @@ pwm0_4ch_1
 rm_io12_pwm0_ch0
 rm_io13_pwm0_ch1
 sai2
+snd_pins
 uart5
 uart5m0_xfer
-- 
2.43.0
