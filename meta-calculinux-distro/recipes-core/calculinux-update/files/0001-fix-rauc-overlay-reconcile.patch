diff --git a/tests/test_version_compat.py b/tests/test_version_compat.py
index b877766..6f6ed7f 100644
--- a/tests/test_version_compat.py
+++ b/tests/test_version_compat.py
@@ -36,3 +36,24 @@ def test_check_compatibility_detects_major_kernel():
     assert r.upgrade_type == UpgradeType.MAJOR
     assert any(i.category == "kernel" for i in r.issues)
     assert r.overall_level in (CompatLevel.MAJOR_ISSUES, CompatLevel.INCOMPATIBLE)
+
+
+def test_check_compatibility_ranks_multiple_issues():
+    """max() over CompatLevel must work when several fields change (wrynose)."""
+    old = {
+        "CALCULINUX_VERSION": "1.0.0",
+        "KERNEL_VERSION": "6.1.120",
+        "PYTHON_VERSION": "3.13",
+        "YOCTO_VERSION": "walnascar",
+        "CALCULINUX_CODENAME": "walnascar",
+    }
+    new = {
+        "CALCULINUX_VERSION": "1.0.0",
+        "KERNEL_VERSION": "7.1.0",
+        "PYTHON_VERSION": "3.14",
+        "YOCTO_VERSION": "wrynose",
+        "CALCULINUX_CODENAME": "wrynose",
+    }
+    r = check_compatibility(old, new)
+    assert r.overall_level == CompatLevel.MAJOR_ISSUES
+    assert {i.category for i in r.issues} >= {"kernel", "python", "abi", "feeds"}
