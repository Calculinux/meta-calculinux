#!/bin/sh
# systemd generator: wire VTs to yaft or leave kernel gettys alone.
# Reads /etc/default/console (CONSOLE, CONSOLE_TTYS, CONSOLE_FONT / YAFT_FONT).
#
# Usage (systemd): yaft-generator <normal-dir> [early-dir] [late-dir]
# Self-check:      yaft-generator --self-check

set -eu

CONSOLE=yaft
CONSOLE_TTYS="1 2 3 4 5 6"
CONSOLE_FONT=default
YAFT_FONT=
UNITDIR="@SYSTEMD_SYSTEM_UNITDIR@"

self_check=0
normal_dir="${1:-}"

if [ "${1:-}" = "--self-check" ]; then
	self_check=1
	normal_dir=$(mktemp -d)
	# shellcheck disable=SC2064
	trap 'rm -rf "$normal_dir"' EXIT
	CONSOLE=yaft
	CONSOLE_TTYS="1 2"
	CONSOLE_FONT=miniwi
elif [ -z "$normal_dir" ]; then
	echo "yaft-generator: missing output directory" >&2
	exit 1
fi

if [ "$self_check" -eq 0 ] && [ -f /etc/default/console ]; then
	# shellcheck disable=SC1091
	. /etc/default/console
fi

case "$CONSOLE" in
yaft) ;;
kernel)
	if [ "$self_check" -eq 1 ]; then
		echo "yaft-generator: --self-check expects CONSOLE=yaft" >&2
		exit 1
	fi
	exit 0
	;;
*)
	echo "yaft-generator: unknown CONSOLE='$CONSOLE' (use yaft or kernel)" >&2
	exit 1
	;;
esac

# Resolve font path: explicit YAFT_FONT wins, else CONSOLE_FONT profile.
if [ -z "${YAFT_FONT:-}" ]; then
	case "${CONSOLE_FONT:-default}" in
	default|console|"") YAFT_FONT=/usr/share/yaft/console.yaftfont ;;
	miniwi) YAFT_FONT=/usr/share/yaft/miniwi.yaftfont ;;
	unifont) YAFT_FONT=/usr/share/yaft/unifont.yaftfont ;;
	*)
		echo "yaft-generator: unknown CONSOLE_FONT='$CONSOLE_FONT' (default|miniwi|unifont)" >&2
		exit 1
		;;
	esac
fi

wants="$normal_dir/getty.target.wants"
mkdir -p "$wants"
mkdir -p "$normal_dir/yaft@.service.d"
printf '%s\n' '[Service]' "Environment=YAFT_FONT=$YAFT_FONT" \
	> "$normal_dir/yaft@.service.d/10-font.conf"

for n in $CONSOLE_TTYS; do
	ln -sf "$UNITDIR/yaft@.service" "$wants/yaft@tty${n}.service"
	# Mask getty@ttyN so systemd-getty-generator's wants are inert.
	ln -sf /dev/null "$normal_dir/getty@tty${n}.service"
done

if [ "$self_check" -eq 1 ]; then
	[ -L "$wants/yaft@tty1.service" ] || { echo "missing yaft@tty1 wants" >&2; exit 1; }
	[ -L "$wants/yaft@tty2.service" ] || { echo "missing yaft@tty2 wants" >&2; exit 1; }
	[ "$(readlink "$normal_dir/getty@tty1.service")" = "/dev/null" ] || {
		echo "getty@tty1 not masked" >&2
		exit 1
	}
	[ ! -e "$wants/yaft@tty3.service" ] || { echo "unexpected tty3" >&2; exit 1; }
	grep -q 'YAFT_FONT=/usr/share/yaft/miniwi.yaftfont' \
		"$normal_dir/yaft@.service.d/10-font.conf" || {
		echo "font drop-in missing miniwi path" >&2
		exit 1
	}
	echo "yaft-generator: self-check ok"
fi

exit 0
