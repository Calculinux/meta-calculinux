#!/bin/sh
# Apply /etc/default/console without a reboot.
# Usage: console-mode apply

set -eu

DEFAULTS=/etc/default/console
CONSOLE=cruft
CONSOLE_TTYS="1 2 3 4 5 6"
CONSOLE_FONT=default
CRUFT_FONT=
YAFT_FONT=

if [ -f "$DEFAULTS" ]; then
	# shellcheck disable=SC1090
	. "$DEFAULTS"
fi

usage() {
	echo "Usage: $0 apply" >&2
	echo "  Reads $DEFAULTS (CONSOLE=cruft|kernel, CONSOLE_FONT=...) and restarts local VTs." >&2
	exit 1
}

[ "${1:-}" = "apply" ] || usage

case "$CONSOLE" in
yaft) CONSOLE=cruft ;;
esac

case "$CONSOLE" in
cruft|kernel) ;;
*)
	echo "console-mode: unknown CONSOLE='$CONSOLE'" >&2
	exit 1
	;;
esac

resolve_font() {
	if [ -n "${CRUFT_FONT:-}" ]; then
		return 0
	fi
	if [ -n "${YAFT_FONT:-}" ]; then
		CRUFT_FONT=$YAFT_FONT
		return 0
	fi
	case "${CONSOLE_FONT:-default}" in
	default|console|"") CRUFT_FONT=/usr/share/cruft/console.cruftfont ;;
	miniwi) CRUFT_FONT=/usr/share/cruft/miniwi.cruftfont ;;
	unifont) CRUFT_FONT=/usr/share/cruft/unifont.cruftfont ;;
	*)
		echo "console-mode: unknown CONSOLE_FONT='$CONSOLE_FONT' (default|miniwi|unifont)" >&2
		exit 1
		;;
	esac
}

if [ "$CONSOLE" = "cruft" ]; then
	resolve_font
	if [ ! -r "$CRUFT_FONT" ]; then
		echo "console-mode: font not installed or unreadable: $CRUFT_FONT" >&2
		echo "console-mode: install miniwi-console / unifont-console, or fix CONSOLE_FONT" >&2
		exit 1
	fi
fi

# Regenerate cruft@.service.d drop-in (CRUFT_FONT / TERM) from $DEFAULTS.
systemctl daemon-reload

failed=0
for n in $CONSOLE_TTYS; do
	systemctl stop "cruft@tty${n}.service" "yaft@tty${n}.service" "getty@tty${n}.service" 2>/dev/null || true
done

for n in $CONSOLE_TTYS; do
	if [ "$CONSOLE" = "cruft" ]; then
		if ! systemctl start "cruft@tty${n}.service"; then
			echo "console-mode: failed to start cruft@tty${n}" >&2
			systemctl --no-pager -l status "cruft@tty${n}.service" 2>&1 | tail -n 20 >&2 || true
			failed=1
		fi
	else
		if ! systemctl start "getty@tty${n}.service"; then
			echo "console-mode: failed to start getty@tty${n}" >&2
			failed=1
		fi
	fi
done

if [ "$CONSOLE" = "cruft" ]; then
	env_line=$(systemctl show -p Environment "cruft@tty1.service" 2>/dev/null || true)
	echo "console-mode: CONSOLE=$CONSOLE CONSOLE_FONT=${CONSOLE_FONT:-default}"
	echo "console-mode: font file $CRUFT_FONT"
	echo "console-mode: tty1 $env_line"
	for n in $CONSOLE_TTYS; do
		state=$(systemctl is-active "cruft@tty${n}.service" 2>/dev/null || echo unknown)
		echo "console-mode: cruft@tty${n} is-active=$state"
	done
else
	echo "console-mode: CONSOLE=$CONSOLE on tty$(echo $CONSOLE_TTYS | tr ' ' ',')"
fi

exit "$failed"
