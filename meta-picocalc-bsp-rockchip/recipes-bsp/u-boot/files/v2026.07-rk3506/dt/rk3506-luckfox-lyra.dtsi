#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "rk3506.dtsi"

/ {
	aliases {
		mmc0 = &sdmmc;
		serial0 = &uart0;
		spi0 = &spi0;
		i2c2 = &i2c2;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-recovery {
			label = "Recovery";
			linux,code = <KEY_VENDOR>;
			press-threshold-microvolt = <0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_RED>;
			default-state = "on";
			function = LED_FUNCTION_HEARTBEAT;
			gpios = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			pinctrl-names = "default";
			pinctrl-0 = <&led1>;
		};
	};

	vcc_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
	};

	vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_sd: regulator-3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3>;
	};

	vcc5v0_sys: regulator-5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};
};

/* RMIO syscon used by PicoCalc remux SPI0 / I2C2 pinmux */
&pinctrl {
	rockchip,rmio = <&grf_pmu>;

	/* Minimal pinconf (WIP rk3506 DT omits rockchip-pinconf.dtsi) */
	pcfg_pull_none: pcfg-pull-none {
		bias-disable;
	};

	pcfg_pull_up: pcfg-pull-up {
		bias-pull-up;
	};

	pcfg_pull_none_drv_level_3: pcfg-pull-none-drv-level-3 {
		bias-disable;
		drive-strength = <3>;
	};

	leds {
		/omit-if-no-ref/
		led1: led1 {
			rockchip,pins = <1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	/*
	 * PicoCalc remux pins (same values as Linux rk3506-pinctrl-rmio.dtsi /
	 * picocalc-luckfox-lyra.dtsi).
	 */
	rm_io {
		/omit-if-no-ref/
		rm_io4_spi0_csn0: rm-io4-spi0-csn0 {
			rockchip,pins = <0 RK_PA4 85 &pcfg_pull_none_drv_level_3>;
		};

		/omit-if-no-ref/
		rm_io5_spi0_miso: rm-io5-spi0-miso {
			rockchip,pins = <0 RK_PA5 84 &pcfg_pull_none_drv_level_3>;
		};

		/omit-if-no-ref/
		rm_io6_spi0_mosi: rm-io6-spi0-mosi {
			rockchip,pins = <0 RK_PA6 83 &pcfg_pull_none_drv_level_3>;
		};

		/omit-if-no-ref/
		rm_io7_spi0_clk: rm-io7-spi0-clk {
			rockchip,pins = <0 RK_PA7 82 &pcfg_pull_none_drv_level_3>;
		};

		/omit-if-no-ref/
		rm_io10_i2c2_scl: rm-io10-i2c2-scl {
			rockchip,pins = <0 RK_PB2 34 &pcfg_pull_none>;
		};

		/omit-if-no-ref/
		rm_io11_i2c2_sda: rm-io11-i2c2-sda {
			rockchip,pins = <0 RK_PB3 35 &pcfg_pull_none>;
		};

		/omit-if-no-ref/
		ili9488_pins: ili9488-pins {
			rockchip,pins =
				<0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&fspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		bootph-pre-ram;
		bootph-some-ram;
		spi-max-frequency = <80000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
		vcc-supply = <&vcc_3v3>;
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io10_i2c2_scl &rm_io11_i2c2_sda>;
	clock-frequency = <400000>;
};

&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io4_spi0_csn0 &rm_io5_spi0_miso
		     &rm_io6_spi0_mosi &rm_io7_spi0_clk>;
	num-cs = <1>;

	ili9488: ili9488@0 {
		compatible = "ilitek,ili9488", "picocalc,spilcd";
		reg = <0>;
		spi-max-frequency = <80000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&ili9488_pins>;
		dc-gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
	};
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&sdmmc {
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-sdio;
	vmmc-supply = <&vcc3v3_sd>;
	status = "okay";
};

&uart0 {
	status = "okay";
};

&usb20_otg0 {
	status = "okay";
};

&usb20_otg1 {
	dr_mode = "host";
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&usb2phy_otg0 {
	status = "okay";
};

&usb2phy_otg1 {
	status = "okay";
};
