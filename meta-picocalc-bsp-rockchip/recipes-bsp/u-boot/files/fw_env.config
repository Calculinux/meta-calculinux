# Offsets are relative to the ubootenv partition device node (not the whole disk).
# U-Boot CONFIG_ENV_OFFSET in calculinux.cfg is the absolute disk offset (6 MiB);
# that GPT partition starts there, so userspace sees primary at 0 and redundant at 0x8000.
/dev/disk/by-partlabel/ubootenv	0x0000000	0x8000
/dev/disk/by-partlabel/ubootenv	0x0008000	0x8000
