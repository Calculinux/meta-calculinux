From: Calculinux <noreply@calculinux.org>
Subject: [PATCH] lib/fonts: add Terminus 6x12 console font

Add a built-in Terminus 6x12 (ter-u12n) fbcon font so the kernel console
matches the cruft userspace console, whose default font is Terminus 6x12.
On a 320x320 panel this gives a 53x26 console instead of the 80x53 grid
from MINI4x6, which fbcon autoselects because it favours <=8px fonts
below 400 lines.

font_ter6x12.c is generated from Terminus 4.49.1 in CP437 order by
meta-picocalc-bsp-rockchip/recipes-kernel/linux/files/gen-font-ter6x12.py.

Upstream-Status: Inappropriate [Calculinux-specific]

Signed-off-by: Calculinux <noreply@calculinux.org>
---
diff --git a/include/linux/font.h b/include/linux/font.h
--- a/include/linux/font.h
+++ b/include/linux/font.h
@@ -35,6 +35,7 @@
 #define FONT6x10_IDX	10
 #define TER16x32_IDX	11
 #define FONT6x8_IDX	12
+#define TER6x12_IDX	13
 
 extern const struct font_desc	font_vga_8x8,
 			font_vga_8x16,
@@ -48,7 +49,8 @@
 			font_mini_4x6,
 			font_6x10,
 			font_ter_16x32,
-			font_6x8;
+			font_6x8,
+			font_ter_6x12;
 
 /* Find a font with a specific name */
 
diff --git a/lib/fonts/fonts.c b/lib/fonts/fonts.c
--- a/lib/fonts/fonts.c
+++ b/lib/fonts/fonts.c
@@ -60,6 +60,9 @@
 #ifdef CONFIG_FONT_6x8
 	&font_6x8,
 #endif
+#ifdef CONFIG_FONT_TER6x12
+	&font_ter_6x12,
+#endif
 };
 
 #define num_fonts ARRAY_SIZE(fonts)
diff --git a/lib/fonts/font_ter6x12.c b/lib/fonts/font_ter6x12.c
--- a/lib/fonts/font_ter6x12.c
+++ b/lib/fonts/font_ter6x12.c
@@ -0,0 +1,3608 @@
