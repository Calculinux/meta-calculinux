#!/bin/sh
# Calculinux emulator: boots calculinux-qemuarm in the bundled QEMU.
#
# The system image is downloaded on first launch (or given with --image) and
# kept read-only; changes go to a qcow2 overlay and the U-Boot environment
# (RAUC A/B state) to a flash image, all under $CALCULINUX_EMULATOR_HOME
# (default ~/.local/share/calculinux-emulator).
set -eu

HERE="$(dirname "$(readlink -f "$0")")"
SYSROOT="$HERE/sysroot"
IMAGES="$HERE/images"
STATE="${CALCULINUX_EMULATOR_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/calculinux-emulator}"
VERSION="$(cat "$IMAGES/version")"
IMAGE_URL="${CALCULINUX_EMULATOR_IMAGE_URL:-$(cat "$IMAGES/image-url")}"

usage() {
    cat <<EOF
Calculinux emulator $VERSION

Usage: ${ARGV0:-calculinux-emulator} [options] [-- extra QEMU arguments]

  --image FILE      boot this image (qcow2, or raw .wic) instead of the
                    downloaded one; e.g. your own calculinux-qemuarm build
  --update-image    download the latest published image if it changed
  --nographic       no window; serial console on this terminal (Ctrl-a x quits)
  --scale N         open the window at N times the 320x320 display (default 2);
                    resizing the window scales it too
  --ssh-port PORT   forward localhost:PORT to the guest's SSH (default 2222,
                    "off" for none)
  --reset           discard saved state (disk changes, U-Boot environment)
  --help            show this help

In the window: log in as root/root or pico/calc. From the terminal that
started it, the serial console is also available (Ctrl-a x quits).
Image: $IMAGE_URL
State: $STATE
EOF
}

nographic=0
scale=2
ssh_port=2222
reset=0
update=0
image=""
while [ $# -gt 0 ]; do
    case "$1" in
        --image) image="$(readlink -f "$2")"; shift ;;
        --update-image) update=1 ;;
        --nographic) nographic=1 ;;
        --scale) scale="$2"; shift ;;
        --ssh-port) ssh_port="$2"; shift ;;
        --reset) reset=1 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        *) echo "Unknown option: $1 (see --help)" >&2; exit 2 ;;
    esac
    shift
done

say() {
    echo "calculinux-emulator: $*" >&2
}

case "$scale" in
    [1-9]) ;;
    *) say "--scale takes a whole number from 1 to 9"; exit 2 ;;
esac

# The bundled binaries are nativesdk builds: run them through the bundled
# dynamic loader so they use only the libraries shipped here.
LOADER="$(ls "$SYSROOT"/lib/ld-linux-*.so.* | head -n 1)"
LIBS="$SYSROOT/lib:$SYSROOT/usr/lib"
run() {
    exe="$1"
    shift
    "$LOADER" --library-path "$LIBS" "$SYSROOT/usr/bin/$exe" "$@"
}
# X11 locale and XKB keymap data come from the host (the bundled libX11 and
# libxkbcommon would look in their build-time paths).
if [ -d /usr/share/X11/locale ]; then
    export XLOCALEDIR=/usr/share/X11/locale
fi
if [ -d /usr/share/X11/xkb ]; then
    export XKB_CONFIG_ROOT=/usr/share/X11/xkb
fi
# X11 first (XWayland on Wayland desktops), native Wayland if there is no X
# server; fail loudly rather than fall back to an invisible window.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11,wayland}"

fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl -fL --progress-bar -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --show-progress -O "$2" "$1"
    else
        say "need curl or wget to download the system image"
        return 1
    fi
}

DOWNLOADED="$STATE/images/calculinux.qcow2"
SUM="$DOWNLOADED.sha256"
DISK="$STATE/disk.qcow2"
ENV_FLASH="$STATE/uboot-env.img"
mkdir -p "$STATE/images"

if [ "$reset" = 1 ]; then
    rm -f "$DISK" "$ENV_FLASH" "$STATE/image-id"
fi

# Pick the base image and an id for it (the overlay is only valid on the
# base it was created from).
if [ -n "$image" ]; then
    [ -f "$image" ] || { say "no such image: $image"; exit 1; }
    base="$image"
    case "$image" in
        *.wic|*.img) base_fmt=raw ;;
        *) base_fmt=qcow2 ;;
    esac
    image_id="local $(stat -c '%s %Y' "$image") $image"
else
    if [ ! -f "$DOWNLOADED" ] || [ "$update" = 1 ]; then
        if ! fetch "$IMAGE_URL.sha256" "$SUM.new"; then
            rm -f "$SUM.new"
            say "could not fetch $IMAGE_URL.sha256"
            [ -f "$DOWNLOADED" ] || exit 1
            say "keeping the image already downloaded"
        elif [ -f "$DOWNLOADED" ] && [ -f "$SUM" ] && \
             [ "$(cut -d' ' -f1 "$SUM.new")" = "$(cut -d' ' -f1 "$SUM")" ]; then
            rm -f "$SUM.new"
            say "image is up to date"
        else
            say "downloading $IMAGE_URL"
            fetch "$IMAGE_URL" "$DOWNLOADED.part"
            want="$(cut -d' ' -f1 "$SUM.new")"
            got="$(sha256sum "$DOWNLOADED.part" | cut -d' ' -f1)"
            if [ "$want" != "$got" ]; then
                rm -f "$DOWNLOADED.part" "$SUM.new"
                say "checksum mismatch for the downloaded image"
                exit 1
            fi
            mv "$DOWNLOADED.part" "$DOWNLOADED"
            mv "$SUM.new" "$SUM"
        fi
    fi
    base="$DOWNLOADED"
    base_fmt=qcow2
    image_id="$(cut -d' ' -f1 "$SUM")"
fi

# A different base image invalidates the overlay; start fresh.
if [ -f "$DISK" ] && [ "$image_id" != "$(cat "$STATE/image-id" 2>/dev/null || true)" ]; then
    say "system image changed; resetting saved state"
    rm -f "$DISK" "$ENV_FLASH"
fi
if [ ! -f "$DISK" ]; then
    run qemu-img create -q -f qcow2 -F "$base_fmt" -b "$base" "$DISK"
    printf '%s\n' "$image_id" > "$STATE/image-id"
fi
# Keep the overlay pointing at the current base path.
run qemu-img rebase -q -u -F "$base_fmt" -b "$base" "$DISK"
if [ ! -f "$ENV_FLASH" ]; then
    # Second pflash bank (64 MiB) holds the U-Boot environment.
    truncate -s 64M "$ENV_FLASH"
fi

netdev="user,id=net0"
if [ "$ssh_port" != off ]; then
    netdev="$netdev,hostfwd=tcp:127.0.0.1:$ssh_port-:22"
fi

if [ "$nographic" = 1 ]; then
    set -- -nographic "$@"
else
    set -- -display "sdl,scale=$scale" -device virtio-gpu-pci,xres=320,yres=320 "$@"
    if [ -t 0 ]; then
        set -- -serial mon:stdio "$@"
    fi
fi

exec "$LOADER" --library-path "$LIBS" "$SYSROOT/usr/bin/qemu-system-arm" \
    -name "Calculinux $VERSION" \
    -L "$SYSROOT/usr/share/qemu" \
    -machine @QEMU_MACHINE@ -cpu @QEMU_CPU@ -smp @QEMU_SMP@ -m @QEMU_MEM@ \
    -bios "$IMAGES/u-boot.bin" \
    -drive if=pflash,unit=1,format=raw,file="$ENV_FLASH" \
    -drive if=virtio,format=qcow2,file="$DISK" \
    -netdev "$netdev" \
    -device virtio-net-device,netdev=net0 \
    -device qemu-xhci -device usb-kbd \
    "$@"
