#!/bin/sh
# Calculinux emulator: boots calculinux-qemuarm in the bundled QEMU.
#
# The system image is chosen and downloaded by the bundled launcher (a window,
# or headless with --select/--no-launcher/--nographic), or given with --image.
# It is kept read-only; changes go to a qcow2 overlay and the U-Boot
# environment (RAUC A/B state) to a flash image, per image, all under
# $CALCULINUX_EMULATOR_HOME (default ~/.local/share/calculinux-emulator).
set -eu

HERE="$(dirname "$(readlink -f "$0")")"
SYSROOT="$HERE/sysroot"
IMAGES="$HERE/images"
STATE="${CALCULINUX_EMULATOR_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/calculinux-emulator}"
VERSION="$(cat "$IMAGES/version")"
INDEX_URL="${CALCULINUX_EMULATOR_INDEX_URL:-$(cat "$IMAGES/index-url")}"
DEFAULT_ID="$(cat "$IMAGES/default-id")"
# The image this build was made for; offered if the index cannot be fetched.
FALLBACK_URL="$(cat "$IMAGES/image-url")"

usage() {
    cat <<EOF
Calculinux emulator $VERSION

Usage: ${ARGV0:-calculinux-emulator} [options] [-- extra QEMU arguments]

Without options a window lists the published system images: pick one to
download and boot it, or delete the ones you no longer need.

  --select ID       boot this published image (see --list), downloading it
                    if needed, without the window
  --no-launcher     boot the image used last time, without the window
  --image FILE      boot this image (qcow2, or raw .wic) instead of a
                    published one; e.g. your own calculinux-qemuarm build
  --update-image    download the image again if a newer one was published
  --list            list the published images and which are downloaded
  --download ID     download (or update) a published image and exit
  --remove ID       delete a downloaded image and its saved state, and exit
  --nographic       no window; serial console on this terminal (Ctrl-a x quits)
  --scale N         open the window at N times the 320x320 display (default 2);
                    resizing the window scales it too
  --ssh-port PORT   forward localhost:PORT to the guest's SSH (default 2222,
                    "off" for none)
  --reset           discard the image's saved state (disk changes, U-Boot
                    environment)
  --help            show this help

In the window: log in as root/root or pico/calc. From the terminal that
started it, the serial console is also available (Ctrl-a x quits).
Images: $INDEX_URL
State:  $STATE
EOF
}

need_arg() {
    [ "$1" -ge 2 ] || { echo "calculinux-emulator: $2 requires an argument" >&2; exit 2; }
}

nographic=0
scale=2
ssh_port=2222
ssh_port_given=0
reset=0
update=0
image=""
select=""
launcher=1
action=""
action_id=""
while [ $# -gt 0 ]; do
    case "$1" in
        --image) need_arg $# "$1"; image="$(readlink -f "$2")"; shift ;;
        --select) need_arg $# "$1"; select="$2"; shift ;;
        --no-launcher) launcher=0 ;;
        --update-image) update=1 ;;
        --list) action=list ;;
        --download) need_arg $# "$1"; action=download; action_id="$2"; shift ;;
        --remove) need_arg $# "$1"; action=remove; action_id="$2"; shift ;;
        --nographic) nographic=1 ;;
        --scale) need_arg $# "$1"; scale="$2"; shift ;;
        --ssh-port) need_arg $# "$1"; ssh_port="$2"; ssh_port_given=1; shift ;;
        --reset) reset=1 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        *) echo "Unknown option: $1 (see --help)" >&2; exit 2 ;;
    esac
    shift
done

say() {
    echo "calculinux-emulator: $*" >&2
}

case "$scale" in
    [1-9]) ;;
    *) say "--scale takes a whole number from 1 to 9"; exit 2 ;;
esac

# The bundled binaries are nativesdk builds: run them through the bundled
# dynamic loader so they use only the libraries shipped here.
LOADER="$(ls "$SYSROOT"/lib/ld-linux-*.so.* | head -n 1)"
LIBS="$SYSROOT/lib:$SYSROOT/usr/lib"
run() {
    exe="$1"
    shift
    "$LOADER" --library-path "$LIBS" "$SYSROOT/usr/bin/$exe" "$@"
}
# X11 locale and XKB keymap data come from the host (the bundled libX11 and
# libxkbcommon would look in their build-time paths).
if [ -d /usr/share/X11/locale ]; then
    export XLOCALEDIR=/usr/share/X11/locale
fi
if [ -d /usr/share/X11/xkb ]; then
    export XKB_CONFIG_ROOT=/usr/share/X11/xkb
fi
# X11 first (XWayland on Wayland desktops), native Wayland if there is no X
# server; fail loudly rather than fall back to an invisible window.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11,wayland}"

# Everything about published images (index, downloads, the state directory's
# images/) is the launcher's; this script only boots what it hands back.
launch() {
    run calculinux-emulator-launcher \
        --state "$STATE" \
        --index-url "$INDEX_URL" \
        --default-id "$DEFAULT_ID" \
        --fallback-url "$FALLBACK_URL" \
        --app-version "$VERSION" \
        --ca-bundle "$SYSROOT/etc/ssl/certs/ca-certificates.crt" \
        "$@"
}

case "$action" in
    list) launch list; exit ;;
    download) launch fetch "$action_id" --update >/dev/null; exit ;;
    remove) launch remove "$action_id"; exit ;;
esac

# Pick the base image, the directory holding its overlay, and an id for it
# (the overlay is only valid on the base it was created from).
if [ -n "$image" ]; then
    [ -f "$image" ] || { say "no such image: $image"; exit 1; }
    # A state directory from before the launcher keeps the overlay in the
    # top level; the launcher moves it.
    if [ ! -f "$STATE/layout" ] && [ -f "$STATE/image-id" ]; then
        launch migrate
    fi
    dir="$STATE/local"
    base="$image"
    case "$image" in
        *.wic|*.img) base_fmt=raw ;;
        *) base_fmt=qcow2 ;;
    esac
    image_id="local $(stat -c '%s %Y' "$image") $image"
else
    rc=0
    update_flag=""
    [ "$update" = 0 ] || update_flag=--update
    if [ -n "${CALCULINUX_EMULATOR_IMAGE_URL:-}" ]; then
        # An explicit image URL: no choice to make.
        chosen="$(launch fetch --url "$CALCULINUX_EMULATOR_IMAGE_URL" $update_flag)" || rc=$?
    elif [ "$nographic" = 0 ] && [ "$launcher" = 1 ] && [ -z "$select" ] && [ "$update" = 0 ]; then
        if [ "$ssh_port_given" = 1 ]; then
            chosen="$(launch gui --ssh-port "$ssh_port")" || rc=$?
        else
            chosen="$(launch gui)" || rc=$?
        fi
        case "$rc" in
            10) exit 0 ;;  # window closed without choosing
            20)
                say "cannot open the launcher window; booting the image used last"
                rc=0
                chosen="$(launch fetch --auto)" || rc=$?
                ;;
        esac
    else
        chosen="$(launch fetch "${select:---auto}" $update_flag)" || rc=$?
    fi
    [ "$rc" = 0 ] || exit "$rc"

    id="$(printf '%s\n' "$chosen" | sed -n 's/^id=//p' | tail -n 1)"
    [ -n "$id" ] || { say "no image was chosen"; exit 1; }
    if [ "$ssh_port_given" = 0 ]; then
        port="$(printf '%s\n' "$chosen" | sed -n 's/^ssh_port=//p' | tail -n 1)"
        [ -z "$port" ] || ssh_port="$port"
    fi
    dir="$STATE/images/$id"
    base="$dir/base.qcow2"
    base_fmt=qcow2
    image_id="$(cut -d' ' -f1 "$base.sha256")"
fi

DISK="$dir/disk.qcow2"
ENV_FLASH="$dir/uboot-env.img"
mkdir -p "$dir"

if [ "$reset" = 1 ]; then
    rm -f "$DISK" "$ENV_FLASH" "$dir/image-id"
fi

# A different base image invalidates the overlay; start fresh.
if [ -f "$DISK" ] && [ "$image_id" != "$(cat "$dir/image-id" 2>/dev/null || true)" ]; then
    say "system image changed; resetting saved state"
    rm -f "$DISK" "$ENV_FLASH"
fi
if [ ! -f "$DISK" ]; then
    run qemu-img create -q -f qcow2 -F "$base_fmt" -b "$base" "$DISK"
    printf '%s\n' "$image_id" > "$dir/image-id"
fi
# Keep the overlay pointing at the current base path.
run qemu-img rebase -q -u -F "$base_fmt" -b "$base" "$DISK"
if [ ! -f "$ENV_FLASH" ]; then
    # Second pflash bank (64 MiB) holds the U-Boot environment.
    truncate -s 64M "$ENV_FLASH"
fi

netdev="user,id=net0"
if [ "$ssh_port" != off ]; then
    netdev="$netdev,hostfwd=tcp:127.0.0.1:$ssh_port-:22"
fi

if [ "$nographic" = 1 ]; then
    set -- -nographic "$@"
else
    set -- -display "sdl,scale=$scale" -device virtio-gpu-pci,xres=320,yres=320 "$@"
    if [ -t 0 ]; then
        set -- -serial mon:stdio "$@"
    fi
fi

exec "$LOADER" --library-path "$LIBS" "$SYSROOT/usr/bin/qemu-system-arm" \
    -name "Calculinux $VERSION" \
    -L "$SYSROOT/usr/share/qemu" \
    -machine @QEMU_MACHINE@ -cpu @QEMU_CPU@ -smp @QEMU_SMP@ -m @QEMU_MEM@ \
    -bios "$IMAGES/u-boot.bin" \
    -drive if=pflash,unit=1,format=raw,file="$ENV_FLASH" \
    -drive if=virtio,format=qcow2,file="$DISK" \
    -netdev "$netdev" \
    -device virtio-net-device,netdev=net0 \
    -device qemu-xhci -device usb-kbd \
    "$@"
